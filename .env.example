# Copy this file to .env and fill in ONE provider's key. Never commit .env.

# Which LLM provider to use:
#   gemini_native  Gemini through Google's official google-genai SDK (recommended for Gemini)
#   gemini         Gemini through its OpenAI-compatible endpoint
#   openai         OpenAI
LLM_PROVIDER=gemini_native
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional model override. Defaults: gemini_native -> gemini-3.5-flash-lite, gemini -> gemini-2.5-flash,
# openai -> gpt-4o-mini. Model availability changes: list the models your key can use before choosing one.
LLM_MODEL=
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=3000

# Retrieval and ingestion
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=90
MAX_UPLOAD_MB=50
ARXIV_MAX_RESULTS=8
MAX_REVISIONS=2
